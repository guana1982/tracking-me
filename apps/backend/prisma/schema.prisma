generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User - authenticated user via Google OAuth
model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - user owns all their data
  monthPeriods     MonthPeriod[]
  cashFlowChecks   CashFlowCheck[]
  cashFlowSettings CashFlowSettings?
  fixedExpenseTemplates FixedExpenseTemplate[]
  investedPortfolio      InvestedPortfolio?
  portfolioAssetClasses  PortfolioAssetClass[]
  portfolioInstruments   PortfolioInstrument[]

  @@index([googleId])
  @@index([email])
  @@map("users")
}

// Portfolio Asset Class - user-defined classes (Azionario, Obbligazionario, etc.)
model PortfolioAssetClass {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  instruments PortfolioInstrument[]

  @@unique([userId, name])
  @@index([userId])
  @@map("portfolio_asset_classes")
}

// Invested Portfolio - persisted real portfolio allocation per user
model InvestedPortfolio {
  id            String   @id @default(cuid())
  userId        String   @unique
  positionsJson Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("invested_portfolios")
}

// Portfolio Instrument - user catalog of investable instruments
model PortfolioInstrument {
  id           String   @id @default(cuid())
  userId     String
  symbol       String
  name         String
  isin         String
  assetClassId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetClass PortfolioAssetClass @relation(fields: [assetClassId], references: [id], onDelete: Restrict)

  @@unique([userId, symbol])
  @@unique([userId, isin])
  @@index([userId])
  @@index([assetClassId])
  @@map("portfolio_instruments")
}

// Month Period - represents a budget month (e.g., 2026-01)
model MonthPeriod {
  id          String   @id @default(cuid())
  userId      String
  year        Int
  month       Int      // 1-12
  periodKey   String   // YYYY-MM format for easy querying
  isClosed    Boolean  @default(false) // When true, no edits allowed
  closedAt    DateTime? // When the month was closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetRule    BudgetRule?
  incomes       Income[]
  expenses      Expense[]
  reallocations Reallocation[]

  @@unique([userId, periodKey])
  @@unique([userId, year, month])
  @@index([periodKey])
  @@index([userId])
  @@map("month_periods")
}

// Budget Rule - configurable percentages for a month
model BudgetRule {
  id                          String   @id @default(cuid())
  monthPeriodId               String   @unique
  needsPct                    Float    @default(65)
  wantsPct                    Float    @default(25)
  savingsPct                  Float    @default(10)
  cutoffDay                   Int      @default(26) // Day of month for reallocation
  autoReallocateNeedsRemainder Boolean @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Relations
  monthPeriod MonthPeriod @relation(fields: [monthPeriodId], references: [id], onDelete: Cascade)

  @@map("budget_rules")
}

// Income - monthly income entry
model Income {
  id            String   @id @default(cuid())
  monthPeriodId String
  label         String
  amount        Float    // Store as float (EUR), we'll handle precision in app
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  monthPeriod MonthPeriod @relation(fields: [monthPeriodId], references: [id], onDelete: Cascade)

  @@index([monthPeriodId])
  @@map("incomes")
}

// Category enum (EXTRA is tracked outside the 65/25/10 budget)
enum Category {
  NEEDS
  WANTS
  SAVINGS
  EXTRA
}

// Tricount type enum for shared expenses
enum TricountType {
  IO
  FRA
}

// Expense - individual expense entry
model Expense {
  id            String        @id @default(cuid())
  monthPeriodId String
  date          DateTime
  category      Category
  label         String
  amount        Float         // Store as float (EUR)
  notes         String?
  isFixed       Boolean       @default(false)  // Fixed monthly expense
  tricountType  TricountType?                  // Shared expense type (IO/FRA)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  monthPeriod MonthPeriod @relation(fields: [monthPeriodId], references: [id], onDelete: Cascade)

  @@index([monthPeriodId])
  @@index([category])
  @@index([date])
  @@map("expenses")
}

// Fixed Expense Template - recurring monthly defaults
model FixedExpenseTemplate {
  id        String   @id @default(cuid())
  userId    String
  category  Category
  label     String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@map("fixed_expense_templates")
}

// Reallocation - transfer between categories at end of month
model Reallocation {
  id            String   @id @default(cuid())
  monthPeriodId String
  fromCategory  Category
  toCategory    Category
  amount        Float
  executedAt    DateTime @default(now())
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  monthPeriod MonthPeriod @relation(fields: [monthPeriodId], references: [id], onDelete: Cascade)

  @@index([monthPeriodId])
  @@map("reallocations")
}

// CashFlow Check - net worth snapshot at a point in time
model CashFlowCheck {
  id              String   @id @default(cuid())
  userId          String
  checkLabel      String
  date            DateTime @db.Date
  bbva            Float    @default(0)
  tradeRepublic   Float    @default(0)
  webankCc        Float    @default(0)
  webankObbl      Float    @default(0)
  etfLordo        Float    @default(0)
  rendimentoLordo Float    @default(0)
  bper            Float    @default(0)
  tricount        Float    @default(0)
  cartaWebank     Float    @default(0)
  edenred         Float    @default(0)
  valuesJson      Json     @default("{}")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("cashflow_checks")
}

// CashFlow Settings - per-user commission/ETF configuration
model CashFlowSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  commissionPerEtf Float    @default(12)
  etfCount         Int      @default(12)
  columnsJson           Json     @default("[]")
  classificationsJson   Json     @default("[]")
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cashflow_settings")
}
