FROM node:18-alpine AS builder

# Install pnpm - pinned to the version in package.json's "packageManager".
# Unpinned, this line installed whatever npm published most recently: pnpm 10
# then read "packageManager": "pnpm@8.15.0", tried to download and self-switch
# to pnpm 8, and refused because that binary is not in a lockfile written by
# pnpm 8 (ERR_PNPM_PNPM_ENGINE_IDENTITY_UNVERIFIABLE). Nothing in the repo had
# changed - the build simply was not reproducible.
RUN npm install -g pnpm@8.15.0

WORKDIR /app

# Copy root package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all packages
COPY packages ./packages
COPY apps/frontend ./apps/frontend

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build shared package
RUN pnpm --filter @budget/shared build

# Build frontend
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm --filter @budget/frontend build

# Production stage
FROM node:18-alpine

RUN npm install -g serve

WORKDIR /app

COPY --from=builder /app/apps/frontend/dist ./dist

EXPOSE 3000

CMD ["serve", "-s", "dist", "-l", "3000"]
